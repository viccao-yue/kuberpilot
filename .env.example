APP_PORT=8000
DEBUG=0
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=0

MYSQL_DATABASE=sxdevops
MYSQL_USER=sxdevops
MYSQL_PASSWORD=sxdevops_password
MYSQL_ROOT_PASSWORD=sxdevops_root_password

REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/1

SECRET_KEY=change-me

# 首次启动且库中没有超级用户时，用这个密码创建 admin。留空则不自动创建。
KUBERPILOT_ADMIN_INITIAL_PASSWORD=
# 执行 seed_rbac_demo 时的演示账号密码。留空则每次命令随机生成并打印一次。
KUBERPILOT_DEMO_PASSWORD=

