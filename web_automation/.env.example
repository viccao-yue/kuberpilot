# Gateway settings. Copy to .env only when local overrides are required.
WEB_AUTOMATION_HOST=127.0.0.1
WEB_AUTOMATION_PORT=8010
WEB_AUTOMATION_LOG_LEVEL=INFO
WEB_AUTOMATION_PLATFORM_DIR=platforms/definitions
WEB_AUTOMATION_TASK_DATABASE_PATH=.runtime/collection-tasks.sqlite3
WEB_AUTOMATION_SCHEDULER_ENABLED=1
WEB_AUTOMATION_CALLBACK_ENABLED=0
WEB_AUTOMATION_CALLBACK_URL=http://127.0.0.1:8000/api/alerts/webhooks/web-automation/
WEB_AUTOMATION_CALLBACK_TOKEN=replace-with-a-local-or-secret-managed-token
WEB_AUTOMATION_CALLBACK_TIMEOUT_SECONDS=5
WEB_AUTOMATION_CALLBACK_RETRY_DELAYS_SECONDS=10,30,90

# Local mock credentials. Copy to .env for manual local development; .env is ignored.
CREDENTIAL_MOCK_PLATFORM_READONLY_USERNAME=aiops_robot
CREDENTIAL_MOCK_PLATFORM_READONLY_PASSWORD=replace-with-a-local-only-password
CREDENTIAL_LEGACY_OPS_READONLY_USERNAME=legacy_reader
CREDENTIAL_LEGACY_OPS_READONLY_PASSWORD=replace-with-a-local-only-password
WEB_AUTOMATION_ALLOW_MOCK_DEFAULT_CREDENTIALS=0
PLAYWRIGHT_BROWSERS_PATH=.runtime/playwright-browsers
PLAYWRIGHT_BROWSER_CHANNEL=msedge
